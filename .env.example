# Copier ce fichier en .env.local pour le développement, et renseigner
# les mêmes variables dans l'hébergeur (Vercel) pour la production.
# Voir PAIEMENTS.md pour savoir où trouver chaque valeur.

# URL publique du site, sans « / » final (utilisée pour les retours après paiement)
NEXT_PUBLIC_SITE_URL=https://solidarityimpact.org

# ── Stripe (carte bancaire) ──────────────────────────────────────────────
# sk_test_… en test, sk_live_… en production. NE JAMAIS la publier.
STRIPE_SECRET_KEY=

# ── PayPal ───────────────────────────────────────────────────────────────
# "sandbox" pour les tests, "live" pour les vrais paiements
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
